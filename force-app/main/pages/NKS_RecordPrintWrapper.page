<apex:page
    title="Utskrift"
    showHeader="false"
    sidebar="false"
    standardStylesheets="false"
    cache="false"
    controller="NKS_RecordPrintController"
>
    <div id="nks-print-preview" data-pdf-url="/apex/NKS_RecordPrint?id={!recordId}" aria-busy="true">
        <p id="nks-print-status" role="status">Laster PDF...</p>
        <iframe
            id="nks-print-frame"
            title="Utskrift"
            width="100%"
            height="1000px"
            style="border: none"
            hidden="hidden"
        ></iframe>
    </div>
    <apex:includeScript value="{!$Resource.NKS_RecordPrintPreview}" />
</apex:page>
